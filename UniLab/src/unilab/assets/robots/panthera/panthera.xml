<mujoco model="Panthera-HT_description">
  <compiler angle="radian" meshdir="assets"/>

  <asset>
    <mesh name="base_link" content_type="model/stl" file="base_link.STL"/>
    <mesh name="link1" content_type="model/stl" file="link1.STL"/>
    <mesh name="link2" content_type="model/obj" file="link2.obj"/>
    <mesh name="link3" content_type="model/stl" file="link3.STL"/>
    <mesh name="link4" content_type="model/stl" file="link4.STL"/>
    <mesh name="link5" content_type="model/stl" file="link5.STL"/>
    <mesh name="link6_ttb" content_type="model/stl" file="link6_ttb.STL"/>
  </asset>

  <worldbody>
    <!-- The carriage front is 0.05 m behind the table end at x=-1.37 m. -->
    <body name="rail_carriage" pos="-1.53 0 0.76">
      <joint name="rail_joint" type="slide" axis="0 1 0" range="-0.75 0.75"
        damping="20" armature="0.05"/>
      <geom name="rail_carriage_geom" type="box" pos="0 0 -0.035" size="0.11 0.15 0.04"
        mass="1.5" rgba="0.18 0.20 0.24 1"/>
      <body name="base_link">
      <inertial pos="5.789e-05 -0.00015938 0.0229865" quat="-0.018817 0.711016 0.0172503 0.702712" mass="0.629225" diaginertia="0.00075652 0.000638827 0.000612963"/>
      <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="0.752941 0.752941 0.752941 1" mesh="base_link"/>
      <geom type="mesh" rgba="0.752941 0.752941 0.752941 1" mesh="base_link"/>
      <body name="link1" pos="0 0 0.0584" gravcomp="1">
        <inertial pos="0.00278873 -0.00094387 0.0249184" quat="0.692661 0.650108 0.225614 -0.216051" mass="0.281016" diaginertia="0.000421358 0.000343661 0.000213101"/>
        <joint name="joint1" pos="0 0 0" axis="0 0 1" range="-2.4 2.4" actuatorfrcrange="-21 21"/>
        <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="0.752941 0.752941 0.752941 1" mesh="link1"/>
        <geom type="mesh" rgba="0.752941 0.752941 0.752941 1" mesh="link1"/>
        <body name="link2" pos="0.018199 0 0.053" gravcomp="1">
          <inertial pos="-0.129362 -0.00213339 7.183e-05" quat="0.00988446 0.706238 0.00888299 0.70785" mass="1.51651" diaginertia="0.0227212 0.0226105 0.00044695"/>
          <joint name="joint2" pos="0 0 0" axis="0 1 0" range="-0.1 3.2" actuatorfrcrange="-36 36"/>
          <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="0.752941 0.752941 0.752941 1" mesh="link2"/>
          <geom type="mesh" rgba="0.752941 0.752941 0.752941 1" mesh="link2"/>
          <body name="link3" pos="-0.26 0 0" gravcomp="1">
            <inertial pos="0.163431 -0.00164646 0.0533743" quat="-0.0903299 0.649643 -0.0759146 0.751027" mass="0.669178" diaginertia="0.00543522 0.00538336 0.00051072"/>
            <joint name="joint3" pos="0 0 0" axis="0 -1 0" range="-0.1 4" actuatorfrcrange="-36 36"/>
            <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="0.752941 0.752941 0.752941 1" mesh="link3"/>
            <geom type="mesh" rgba="0.752941 0.752941 0.752941 1" mesh="link3"/>
            <body name="link4" pos="0.23 0 0.06" gravcomp="1">
              <inertial pos="0.0524013 -0.00055249 0.0409418" quat="-0.0119308 0.442275 0.0207973 0.896559" mass="0.307805" diaginertia="0.000483913 0.000395159 0.000124278"/>
              <joint name="joint4" pos="0 0 0" axis="0 -1 0" range="-1.6 1.6" actuatorfrcrange="-21 21"/>
              <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="0.752941 0.752941 0.752941 1" mesh="link4"/>
              <geom type="mesh" rgba="0.752941 0.752941 0.752941 1" mesh="link4"/>
              <body name="link5" pos="0.07 0 0.036319" gravcomp="1">
                <inertial pos="0.00319091 8.677e-05 -0.0364178" quat="0.707308 -0.00204013 0.0109461 0.706818" mass="0.283969" diaginertia="0.000134559 0.000126913 0.000107868"/>
                <joint name="joint5" pos="0 0 0" axis="0 0 -1" range="-1.7 1.7" actuatorfrcrange="-10 10"/>
                <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="0.752941 0.752941 0.752941 1" mesh="link5"/>
                <geom type="mesh" rgba="0.752941 0.752941 0.752941 1" mesh="link5"/>
                <body name="link6" pos="0.02345 0 -0.039" gravcomp="1">
                  <inertial pos="0.107318 0 9.64e-06" quat="0 0.707172 0 0.707042" mass="0.340735" diaginertia="0.00247492 0.00227113 0.00025204"/>
                  <joint name="joint6" pos="0 0 0" axis="1 0 0" range="-2.5 2.5" actuatorfrcrange="-10 10"/>
                  <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="0.752941 0.752941 0.752941 1" mesh="link6_ttb"/>
                  <!-- The visual mesh is deliberately non-colliding. These primitives
                       provide stable, non-overlapping handle and paddle contacts. -->
                  <geom name="paddle_handle_collision" type="box" pos="0.05625 0 0"
                    size="0.04525 0.0225 0.02" rgba="0 0 0 0"/>
                  <!-- The paddle frame origin is the contact-disc center. Its local
                       +Z axis is the task-level striking-surface normal. The geom is
                       massless because link6 already owns the measured rigid-body
                       inertia above. -->
                  <body name="paddle_frame" pos="0.195 0 0">
                    <geom name="paddle_contact" type="cylinder" mass="0"
                      size="0.07 0.00725" rgba="0 0 0 0"
                      friction="0.35 0.005 0.0001" solref="0.004 1"/>
                  </body>
                  <body name="tool_link" pos="0.165 0 0"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
      </body>
    </body>
  </worldbody>

  <!-- SDK trajectory control: MIT PD with zero desired velocity and gravity
       feed-forward. Body gravcomp above supplies the gravity feed-forward. -->
  <actuator>
    <position name="joint1_position" joint="joint1" kp="30" kv="3"
      ctrllimited="true" ctrlrange="-2.4 2.4" forcelimited="true" forcerange="-21 21"/>
    <position name="joint2_position" joint="joint2" kp="50" kv="5"
      ctrllimited="true" ctrlrange="-0.1 3.2" forcelimited="true" forcerange="-36 36"/>
    <position name="joint3_position" joint="joint3" kp="60" kv="6"
      ctrllimited="true" ctrlrange="-0.1 4" forcelimited="true" forcerange="-36 36"/>
    <position name="joint4_position" joint="joint4" kp="25" kv="2.5"
      ctrllimited="true" ctrlrange="-1.6 1.6" forcelimited="true" forcerange="-21 21"/>
    <position name="joint5_position" joint="joint5" kp="15" kv="1.5"
      ctrllimited="true" ctrlrange="-1.7 1.7" forcelimited="true" forcerange="-10 10"/>
    <position name="joint6_position" joint="joint6" kp="10" kv="1"
      ctrllimited="true" ctrlrange="-2.5 2.5" forcelimited="true" forcerange="-10 10"/>
  </actuator>
</mujoco>
